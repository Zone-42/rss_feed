# =============================================================================
# Personal Multi-Source RSS Reader — Local MVP Configuration
# Copy this file to `.env` and fill in optional keys as needed:
#   cp .env.example .env
# =============================================================================

# SQLite database file path (relative to repository root or absolute path)
RSS_DB_PATH=backend/data/rss_reader.db

# Background auto-refresh interval in minutes (set to 0 to disable)
RSS_AUTO_REFRESH_MINUTES=30

# -----------------------------------------------------------------------------
# On-Demand AI Summaries (Optional — configure either Gemini or OpenAI-compatible)
# -----------------------------------------------------------------------------
# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI or OpenAI-compatible API alternative (e.g. DeepSeek, OpenRouter, Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Social Media & Knowledge Export Integrations (Optional)
# -----------------------------------------------------------------------------
# Self-hosted RSSHub base URL for X / Zhihu / Xiaohongshu routes
RSSHUB_BASE_URL=http://localhost:1200

# Default NotebookLM notebook UUID for direct CLI push (requires `nlm` CLI)
NOTEBOOKLM_DEFAULT_ID=eeaf0373-3961-4cba-910f-8198ae2c809f

# =============================================================================
# Phase 2 VPS Production Stack (`deploy/docker-compose.yml`)
# Copy these variables into `deploy/.env` when deploying to a VPS.
# NEVER commit real passwords or tokens!
# =============================================================================
# POSTGRES_USER=miniflux
# POSTGRES_PASSWORD=
# POSTGRES_DB=miniflux
#
# MINIFLUX_ADMIN_USERNAME=admin
# MINIFLUX_ADMIN_PASSWORD=
# MINIFLUX_BASE_URL=https://rss.example.com
# MINIFLUX_MEDIA_PROXY_PRIVATE_KEY=
# MINIFLUX_POLLING_FREQUENCY=60
# MINIFLUX_BATCH_SIZE=100
# MINIFLUX_CLEANUP_ARCHIVE_READ_DAYS=60
#
# RSSHUB_ACCESS_KEY=
# RSSHUB_CACHE_EXPIRE=600
# BROWSERLESS_TOKEN=
# BROWSERLESS_CONCURRENT=2
# BROWSERLESS_QUEUED=5
# BROWSERLESS_TIMEOUT=30000
#
# CLOUDFLARE_TUNNEL_TOKEN=
